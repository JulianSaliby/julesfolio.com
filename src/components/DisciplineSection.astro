---
import { Image } from 'astro:assets';
import { asset } from '../lib/assets';

interface MediaItem {
  title: string;
  href?: string; // present => links to a real /projects/[slug] case study
  cover?: string; // asset() path (single static image)
  covers?: string[]; // asset() paths — cycles as a slideshow
  video?: string; // public/ path (click-to-play)
  poster?: string; // public/ path; if omitted for a video, a frame is auto-previewed from the clip
  meta?: string; // feature tile only
}
interface Props {
  id: string;
  label: string;
  sub: string;
  count: string;
  feature: MediaItem;
  browse: MediaItem[];
  /** When true, clicking a browse video loads & plays it in the feature frame above instead of playing inline in place. */
  videoBrowsePlaysInFeature?: boolean;
  /** Show each browse tile's title caption. Off for a plain thumbnail grid. */
  showBrowseTitles?: boolean;
}
const { id, label, sub, count, feature, browse, videoBrowsePlaysInFeature = false, showBrowseTitles = true } = Astro.props;

const featureCovers = feature.covers ?? (feature.cover ? [feature.cover] : []);
const featureImgs = featureCovers.map((c) => asset(c));
---

<section class="discipline-block" id={id}>
  <div class="discipline-head reveal">
    <h2>{label}</h2>
    <span class="count">{sub} — {count}</span>
  </div>

  <div class="container">
    <div class="mosaic-feature reveal" data-feature={id}>
      <div class="feature-stage">
        {feature.video ? (
          <button type="button" class="tile-media is-video" data-video={feature.video} data-poster={feature.poster} aria-label={`Play ${feature.title} video`}>
            {feature.poster ? (
              <img src={feature.poster} alt={`${feature.title} — work by Julian Saliby`} loading="lazy" />
            ) : (
              <video class="preview" muted preload="metadata" playsinline src={`${feature.video}#t=0.5`}></video>
            )}
            <span class="play-badge" aria-hidden="true">▶</span>
          </button>
        ) : featureImgs.length > 1 ? (
          <div class:list={['tile-media', 'is-slideshow', feature.href && 'is-clickable']} data-href={feature.href}>
            {featureImgs.map((img, i) => (
              <Image src={img} alt={`${feature.title} — work by Julian Saliby`} widths={[700, 1200, 1600]} sizes="100vw" class:list={['slide', i === 0 && 'is-active']} loading={i === 0 ? 'eager' : 'lazy'} />
            ))}
            <div class="slide-progress"><i></i></div>
          </div>
        ) : feature.href ? (
          <a href={feature.href} class="tile-media">
            <Image src={featureImgs[0]} alt={`${feature.title} — work by Julian Saliby`} widths={[700, 1200, 1600]} sizes="100vw" />
          </a>
        ) : (
          <div class="tile-media">
            <Image src={featureImgs[0]} alt={`${feature.title} — work by Julian Saliby`} widths={[700, 1200, 1600]} sizes="100vw" />
          </div>
        )}
      </div>
      <span class="case-flag">Case study</span>
      <div class="ph-tag">
        <strong class="feature-title">{feature.title}</strong>
        <span class="feature-meta">{feature.meta ?? ''}</span>
      </div>
    </div>

    <div class="mosaic-browse">
      {browse.map((it) => {
        const covers = it.covers ?? (it.cover ? [it.cover] : []);
        const browseCover = covers[0];
        const playsInFeature = it.video && videoBrowsePlaysInFeature;
        return (
          <div class="browse-tile reveal">
            {it.video ? (
              <button
                type="button"
                class="tile-media is-video"
                data-video={it.video}
                data-poster={it.poster}
                data-title={it.title}
                data-target-feature={playsInFeature ? id : undefined}
                aria-label={playsInFeature ? `Play ${it.title} in the player above` : `Play ${it.title} video`}
              >
                {it.poster ? (
                  <img src={it.poster} alt={it.title} loading="lazy" />
                ) : (
                  <video class="preview" muted preload="metadata" playsinline src={`${it.video}#t=0.5`}></video>
                )}
                <span class="play-badge small" aria-hidden="true">▶</span>
              </button>
            ) : it.href ? (
              <a href={it.href} class="tile-media">
                <Image src={asset(browseCover!)} alt={it.title} widths={[400, 700]} sizes="(max-width: 820px) 50vw, 300px" loading="lazy" />
              </a>
            ) : (
              <div class="tile-media">
                <Image src={asset(browseCover!)} alt={it.title} widths={[400, 700]} sizes="(max-width: 820px) 50vw, 300px" loading="lazy" />
              </div>
            )}
            {!it.href && <span class="browse-flag">Browse</span>}
            {showBrowseTitles && <div class="ph-tag browse-tag"><span>{it.title}</span></div>}
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .discipline-block { margin-block: clamp(3rem, 7vh, 5.5rem); }
  .discipline-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-inline: var(--gutter);
    max-width: var(--max-media); margin: 0 auto 1rem;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.9rem;
  }
  .discipline-head h2 { font-size: clamp(1.3rem, 2.4vw, 1.9rem); font-weight: 600; letter-spacing: -0.01em; }
  .discipline-head .count { font-size: var(--text-xs); color: var(--text-tertiary); letter-spacing: 0.08em; text-transform: uppercase; }

  /* Feature tile — always a 16:9 frame, regardless of the source image/video's
     native ratio; content crops to fill via object-fit so nothing distorts. */
  .mosaic-feature {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 2px;
    background: var(--bg-elevated);
    margin-bottom: 0.6rem;
  }
  .feature-stage { position: absolute; inset: 0; }

  /* Browse row — a uniform grid of fixed-ratio cards (not a justified row shaped
     by whatever each source clip/photo happens to be). Standard for portfolio
     grids mixing landscape + vertical source media. */
  .mosaic-browse {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 0.6rem;
  }
  .browse-tile {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 2px;
    background: var(--bg-elevated);
  }
  .browse-tile.is-current { outline: 2px solid var(--accent); outline-offset: -2px; }

  .tile-media {
    position: absolute; inset: 0;
    display: block; width: 100%; height: 100%;
    border: 0; padding: 0; margin: 0; cursor: pointer; background: none;
  }
  .tile-media img, .tile-media :global(img), .tile-media video {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .mosaic-feature:hover .tile-media img, .mosaic-feature:hover .tile-media :global(img),
  .browse-tile:hover .tile-media img, .browse-tile:hover .tile-media :global(img) { transform: scale(1.035); }
  .tile-media.has-video-playing { cursor: default; }
  .tile-media.has-video-playing :global(video) { width: 100%; height: 100%; object-fit: cover; }
  /* A video swapped into the feature frame (browse-click → feature-swap path)
     lands as a direct child of .feature-stage, not inside a .tile-media — so
     it needs its own sizing rule, or it renders at its unsized intrinsic
     dimensions instead of filling the frame. */
  .feature-stage :global(video) { width: 100%; height: 100%; object-fit: cover; }

  /* ---- Auto-cycling slideshow — one single progress line, not segmented pips ---- */
  .tile-media.is-slideshow { cursor: default; }
  .tile-media.is-slideshow.is-clickable { cursor: pointer; }
  .tile-media.is-slideshow :global(.slide) {
    position: absolute; inset: 0; opacity: 0;
    transition: opacity 0.5s ease;
  }
  .tile-media.is-slideshow :global(.slide.is-active) { opacity: 1; }
  .slide-progress {
    position: absolute; left: 0.75rem; right: 0.75rem; bottom: 0.75rem;
    z-index: 3;
    height: 2px;
    background: rgba(255,255,255,0.25);
    border-radius: 2px;
    overflow: hidden;
  }
  .slide-progress i {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--text);
    border-radius: 2px;
  }
  .slide-progress i.is-filling { width: 100%; transition: width 5s linear; }

  .play-badge {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 50px; height: 50px; border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.5);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.85rem; color: var(--text);
    background: rgba(10,10,11,0.4);
    -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
    pointer-events: none;
  }
  .play-badge.small { width: 34px; height: 34px; font-size: 0.65rem; }

  .case-flag, .browse-flag {
    position: absolute; top: 0.6rem; right: 0.6rem; z-index: 3;
    font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.2rem 0.5rem; border-radius: 20px;
    pointer-events: none;
  }
  .case-flag { color: var(--text); background: rgba(0,0,0,0.5); border: 1px solid var(--hairline); }
  .browse-flag { color: var(--text-tertiary); }

  .ph-tag {
    position: absolute; inset-inline: 0; bottom: 0; z-index: 2;
    padding: clamp(0.75rem, 1.4vw, 1.25rem);
    background: linear-gradient(to top, rgba(10, 10, 11, 0.85) 0%, rgba(10, 10, 11, 0.02) 65%);
    pointer-events: none;
  }
  .ph-tag strong { display: block; font-size: var(--text-lg); font-weight: 600; letter-spacing: -0.015em; }
  .feature-meta { display: block; margin-top: 0.3rem; font-size: var(--text-sm); color: var(--text-secondary); }
  .feature-meta:empty { display: none; }

  .browse-tag { padding: 0.6rem; }
  .browse-tag span {
    font-size: 0.78rem; color: var(--text-secondary);
    opacity: 0; transform: translateY(3px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease);
    display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .browse-tile:hover .browse-tag span { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .mosaic-browse { grid-template-columns: repeat(2, 1fr); }
    .browse-tag span { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile-media img, .tile-media :global(img), .browse-tag span { transition: none; }
    .tile-media.is-slideshow :global(.slide) { transition: none; }
    .slide-progress i.is-filling { transition: none; width: 100%; }
  }
</style>

<script>
  // ---- Builds a playing <video> element (shared by inline play + feature-swap play) ----
  function buildPlayer(video: string, poster?: string) {
    const el = document.createElement('video');
    el.src = video;
    el.poster = poster ?? '';
    el.controls = true;
    el.autoplay = true;
    el.playsInline = true;
    return el;
  }

  // ---- Click-to-play video tiles that play inline, in place ----
  document.querySelectorAll<HTMLButtonElement>('.tile-media.is-video:not([data-target-feature])').forEach((btn) => {
    btn.addEventListener('click', () => {
      const video = btn.dataset.video;
      if (!video) return;
      const el = buildPlayer(video, btn.dataset.poster);
      btn.replaceChildren(el);
      btn.classList.add('has-video-playing');
      btn.disabled = true;
      el.play().catch(() => {});
    }, { once: true });
  });

  // ---- Click-to-play video tiles that load into the section's feature frame above ----
  document.querySelectorAll<HTMLButtonElement>('.tile-media.is-video[data-target-feature]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const video = btn.dataset.video;
      const featureId = btn.dataset.targetFeature;
      if (!video || !featureId) return;
      const feature = document.querySelector<HTMLElement>(`.mosaic-feature[data-feature="${featureId}"]`);
      const stage = feature?.querySelector<HTMLElement>('.feature-stage');
      if (!feature || !stage) return;

      const el = buildPlayer(video, btn.dataset.poster);
      stage.replaceChildren(el);
      el.play().catch(() => {});

      const title = feature.querySelector('.feature-title');
      const meta = feature.querySelector('.feature-meta');
      if (title) title.textContent = btn.dataset.title ?? title.textContent;
      if (meta) meta.textContent = '';

      feature.parentElement?.querySelectorAll('.browse-tile.is-current').forEach((t) => t.classList.remove('is-current'));
      btn.closest('.browse-tile')?.classList.add('is-current');
    });
  });

  // ---- Auto-cycling slideshow — single progress line, resets and refills each slide ----
  document.querySelectorAll<HTMLElement>('.tile-media.is-slideshow').forEach((el) => {
    const slides = Array.from(el.querySelectorAll<HTMLElement>('.slide'));
    const fill = el.querySelector<HTMLElement>('.slide-progress i');
    if (slides.length < 2 || !fill) return;
    const href = el.dataset.href;
    if (href) el.addEventListener('click', () => { window.location.href = href; });

    let i = 0;
    const DURATION = 5000;

    function runFill() {
      fill!.classList.remove('is-filling');
      // force reflow so the width:0 reset is applied before re-adding the transition class
      void fill!.offsetWidth;
      fill!.classList.add('is-filling');
    }
    function show(next: number) {
      slides[i].classList.remove('is-active');
      i = next;
      slides[i].classList.add('is-active');
      runFill();
    }

    let timer: ReturnType<typeof setInterval> | undefined;
    function start() {
      if (timer) return;
      runFill();
      timer = setInterval(() => show((i + 1) % slides.length), DURATION);
    }
    function stop() {
      clearInterval(timer);
      timer = undefined;
    }
    const io = new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? start() : stop())), { threshold: 0.4 });
    io.observe(el);
  });
</script>
