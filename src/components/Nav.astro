---
import { Image } from 'astro:assets';
import logo from '../assets/branding/logo.png';

const links = [
  { href: '/videography', label: 'Videography' },
  { href: '/photography', label: 'Photography' },
  { href: '/graphic-design', label: 'Graphic Design' },
  { href: '/industrial-design', label: 'Industrial Design' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
const isHome = path === '/';
---

<header class="site-nav">
  <nav class="container nav-inner" aria-label="Main">
    <div class="nav-left">
      {!isHome && (
        // href="/" is the no-JS fallback; the script below swaps in history.back()
        // when it can confirm "back" actually returns to this site.
        <a href="/" class="nav-back" aria-label="Back">← Back</a>
      )}
      <a href="/" class="wordmark" aria-label="Julian Saliby — home">
        <Image src={logo} alt="Julian Saliby" class="logo-mark" widths={[240, 360]} sizes="180px" loading="eager" />
      </a>
    </div>
    <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-links-panel" aria-label="Open menu">
      <span></span>
    </button>
    <ul class="nav-links" id="nav-links-panel">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
      <li><a href="/contact" class="nav-contact">Contact</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    transition: background 0.35s var(--ease), border-color 0.35s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-nav.is-scrolled {
    background: rgba(10, 10, 11, 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom-color: var(--hairline);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }
  .nav-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
  }
  .logo-mark { display: block; height: 45px; width: auto; }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.1rem;
    list-style: none;
    font-size: var(--text-base);
  }
  .nav-links a { color: var(--text-secondary); }
  .nav-links a:hover, .nav-links a[aria-current='page'] { color: var(--text); }
  .nav-contact { color: var(--text) !important; }

  .nav-back {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-base);
    color: var(--text) !important;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.5rem 1.15rem;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .nav-back:hover { border-color: var(--text-tertiary); background: var(--bg-subtle); }

  /* ---- Mobile hamburger toggle — hidden on desktop, where .nav-links shows
     as a plain inline row. Below 820px that row previously overflowed off
     the right edge with no scroll affordance (Contact and some links were
     simply unreachable); it's replaced there by a full-width dropdown. ---- */
  .nav-toggle {
    display: none;
    width: 40px; height: 40px;
    align-items: center; justify-content: center;
    background: none; border: 0; padding: 0; cursor: pointer;
  }
  .nav-toggle span,
  .nav-toggle span::before,
  .nav-toggle span::after {
    display: block;
    width: 20px; height: 1.5px;
    background: var(--text);
    transition: transform 0.25s var(--ease), opacity 0.25s var(--ease);
  }
  .nav-toggle span::before, .nav-toggle span::after { content: ''; position: relative; }
  .nav-toggle span::before { top: -6px; }
  .nav-toggle span::after { top: 4.5px; }
  .nav-toggle[aria-expanded='true'] span { background: transparent; }
  .nav-toggle[aria-expanded='true'] span::before { top: 0; transform: rotate(45deg); }
  .nav-toggle[aria-expanded='true'] span::after { top: -1.5px; transform: rotate(-45deg); }

  @media (max-width: 820px) {
    .nav-inner { height: 3.75rem; }
    .logo-mark { height: 36px; }
    .nav-toggle { display: flex; }
    .nav-links {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: rgba(10, 10, 11, 0.97);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      backdrop-filter: saturate(180%) blur(20px);
      border-bottom: 1px solid var(--hairline);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.35s var(--ease);
    }
    .nav-links.is-open { max-height: 24rem; }
    .nav-links li { border-top: 1px solid var(--hairline); }
    .nav-links a { display: block; padding: 1rem var(--gutter); }
    .nav-contact { color: var(--accent) !important; }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.nav-back').forEach((a) => {
    a.addEventListener('click', (e) => {
      // Only hijack for history.back() when we can confirm the previous
      // entry actually is this site — otherwise the plain href="/" fallback
      // is the safer, more predictable destination (e.g. arriving via a
      // search engine or a link opened in a new tab).
      const sameOriginReferrer = document.referrer && new URL(document.referrer).origin === location.origin;
      if (sameOriginReferrer && window.history.length > 1) {
        e.preventDefault();
        history.back();
      }
    });
  });

  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const panel = document.querySelector<HTMLElement>('.nav-links');
  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    panel?.classList.toggle('is-open', open);
  }
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('click', (e) => {
    if (!panel?.classList.contains('is-open')) return;
    if (e.target instanceof Node && !panel.contains(e.target) && !toggle?.contains(e.target)) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.addEventListener('resize', () => {
    if (window.innerWidth > 820) setOpen(false);
  });
</script>
