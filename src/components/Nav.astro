---
import { Image } from 'astro:assets';
import logo from '../assets/branding/logo.png';

const links = [
  { href: '/videography', label: 'Videography' },
  { href: '/photography', label: 'Photography' },
  { href: '/graphic-design', label: 'Graphic Design' },
  { href: '/industrial-design', label: 'Industrial Design' },
  { href: '/about', label: 'About' },
];
const path = Astro.url.pathname;
const isHome = path === '/';
---

<header class="site-nav">
  <nav class="container nav-inner" aria-label="Main">
    <div class="nav-left">
      {!isHome && (
        // href="/" is the no-JS fallback; the script below swaps in history.back()
        // when it can confirm "back" actually returns to this site.
        <a href="/" class="nav-back" aria-label="Back">← Back</a>
      )}
      <a href="/" class="wordmark" aria-label="Julian Saliby — home">
        <Image src={logo} alt="Julian Saliby" class="logo-mark" widths={[240, 360]} sizes="180px" loading="eager" />
      </a>
    </div>
    <ul class="nav-links">
      {links.map((l) => (
        <li>
          <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>
        </li>
      ))}
      <li><a href="/contact" class="nav-contact">Contact</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-nav {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 100;
    transition: background 0.35s var(--ease), border-color 0.35s var(--ease);
    border-bottom: 1px solid transparent;
  }
  .site-nav.is-scrolled {
    background: rgba(10, 10, 11, 0.72);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom-color: var(--hairline);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
  }
  .nav-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
  }
  .logo-mark { display: block; height: 45px; width: auto; }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 2.1rem;
    list-style: none;
    font-size: var(--text-base);
  }
  .nav-links a { color: var(--text-secondary); }
  .nav-links a:hover, .nav-links a[aria-current='page'] { color: var(--text); }
  .nav-contact { color: var(--text) !important; }

  .nav-back {
    display: inline-flex;
    align-items: center;
    font-size: var(--text-base);
    color: var(--text) !important;
    border: 1px solid var(--hairline);
    border-radius: 999px;
    padding: 0.5rem 1.15rem;
    transition: border-color 0.25s var(--ease), background 0.25s var(--ease);
  }
  .nav-back:hover { border-color: var(--text-tertiary); background: var(--bg-subtle); }

  @media (max-width: 820px) {
    .nav-links { gap: 1.35rem; overflow-x: auto; }
    .nav-inner { height: 3.75rem; }
    .logo-mark { height: 36px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLAnchorElement>('.nav-back').forEach((a) => {
    a.addEventListener('click', (e) => {
      // Only hijack for history.back() when we can confirm the previous
      // entry actually is this site — otherwise the plain href="/" fallback
      // is the safer, more predictable destination (e.g. arriving via a
      // search engine or a link opened in a new tab).
      const sameOriginReferrer = document.referrer && new URL(document.referrer).origin === location.origin;
      if (sameOriginReferrer && window.history.length > 1) {
        e.preventDefault();
        history.back();
      }
    });
  });
</script>
