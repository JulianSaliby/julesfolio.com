---
import Base from '../layouts/Base.astro';
import FlagshipRow from '../components/FlagshipRow.astro';
import DisciplineSection from '../components/DisciplineSection.astro';
import SectionNav from '../components/SectionNav.astro';
import ShortFormReels from '../components/blocks/ShortFormReels.astro';
import PhotoCategoryRow from '../components/blocks/PhotoCategoryRow.astro';
import GalleryGrid from '../components/blocks/GalleryGrid.astro';
import { assetsIn } from '../lib/assets';

// Real brand SVGs for the Industrial Design skills row (same inline-svg
// pattern as ToolStack.astro); PNG app icons for brands with no suitable
// monochrome mark live under public/media/logos/tools instead.
const skillIcons: Record<string, string> = import.meta.glob('../assets/tool-icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const skillIconSvg = (name?: string) => name && skillIcons[`../assets/tool-icons/${name}.svg`];

const sectionNavItems = [
  { href: '#home', label: 'Home' },
  { href: '#work', label: 'Multidisciplinary Projects' },
  { href: '#videography', label: 'Videography' },
  { href: '#short-form-reels', label: 'Short Form Reels' },
  { href: '#photography', label: 'Photography' },
  { href: '#industrial-design', label: 'Industrial Design' },
  { href: '#branding', label: 'Branding' },
  { href: '#graphic-design', label: 'Graphic Design' },
];

// ---- Flagship row — the 4 headline multidisciplinary projects, shown once, up top ----
const flagships = [
  {
    href: '/projects/next-real-estate',
    title: 'Next Real Estate',
    meta: 'Photography · Film · Brand · Print — 2025',
    cover: 'covers/next-real-estate',
  },
  {
    href: '/projects/parallel',
    title: 'Parallel',
    meta: 'Brand · Product Demo Film · Tutorials — 2024–26',
    cover: 'covers/parallel',
  },
  {
    href: '/projects/janera',
    title: 'Janera',
    meta: 'AI Generated — 2026',
    logo: '/media/logos/higgsfield.png',
    logoAlt: 'Higgsfield AI',
    logoLabel: 'AI Generated',
    cover: 'covers/janera',
  },
  {
    href: '/projects/icare',
    title: 'Eye Care — Capstone',
    meta: 'Industrial Design · Full Process Book — 2024',
    cover: 'covers/eye-care-capstone',
  },
];

// ---- Discipline sections — a continuous scroll through the rest of the work.
// Flagships above aren't repeated here; each section leads with its own
// standout, non-flagship piece, then a browse row of the rest. ----
const videography = {
  id: 'videography',
  label: 'Videography',
  sub: 'Client commercials · event coverage · automotive',
  count: '8 pieces',
  feature: {
    href: '/projects/automotive-photography',
    title: 'Automotive — BMW M3 CS',
    meta: 'Videography — automotive',
    video: '/media/videography/bmw-m3-cs.mp4',
  },
  browse: [
    { title: 'Automotive — BMW M3 CS', href: '/projects/automotive-photography', video: '/media/videography/bmw-m3-cs.mp4' },
    { title: 'Next — 508 Sale', href: '/projects/next-real-estate', video: '/media/videography/next-508-sale.mp4' },
    { title: 'Cycleward — Full Crew', video: '/media/videography/cycleward-fullcrew.mp4' },
    { title: 'Vandal Mouse — Commercial', href: '/projects/vandal-gaming-mouse', video: '/media/videography/vandal-mouse-commercial.mp4', previewTime: 8 },
    { title: 'Capstone Video', video: '/media/videography/capstone.mp4', previewTime: 29 },
    { title: 'Ultima — Cars & Coffee', href: '/projects/ultima', video: '/media/videography/cars-and-coffee-ultima.mp4', previewTime: 4.5 },
    { title: 'Unknown Ent — Rabbit Hole', video: '/media/videography/unknown-ent-rabbit-hole.mp4' },
    { title: "Marcello's — TV Spot", video: '/media/videography/marcellos-tv.mp4', previewTime: 28 },
  ],
};
const videographySkills = [
  { name: 'Video Camera', icon: 'video' },
  { name: 'Adobe Premiere Pro', icon: 'premierepro', color: '#b1b1f5' },
];

// ---- Short Form Reels — its own category, sitting between Videography and
// Photography: vertical (9:16) social edits, distinct enough from the 16:9
// discipline sections that they get their own dedicated picker layout. ----
const shortFormReels = [
  { title: 'Brooke — Socials', video: '/media/short-form-reels/brooke-socials.mp4', poster: '/media/short-form-reels-posters/brooke-socials.jpg' },
  { title: 'Final Night', video: '/media/short-form-reels/ai-tour-2.mp4', previewTime: 2 },
  { title: 'Janera — Ad', video: '/media/short-form-reels/janera-ad.mp4', poster: '/media/short-form-reels-posters/janera-ad.jpg' },
  { title: 'Darrken Fitness', video: '/media/short-form-reels/darrken-fitness.mp4', previewTime: 1 },
  { title: 'Burger & Uber', video: '/media/short-form-reels/burger-w-uber.mp4', poster: '/media/short-form-reels-posters/burger-w-uber.jpg' },
  { title: 'Ghostie Pump', video: '/media/short-form-reels/ghostie-pump.mp4', poster: '/media/short-form-reels-posters/ghostie-pump.jpg' },
  { title: 'Dennison — Ad', video: '/media/short-form-reels/dennison-ad.mp4', previewTime: 14 },
  { title: 'MyHookah Giveaway', video: '/media/short-form-reels/myhookah-giveaway.mp4', poster: '/media/short-form-reels-posters/myhookah-giveaway.jpg' },
];
const shortFormReelsSkills = [
  { name: 'Video Camera', icon: 'video' },
  { name: 'Adobe Premiere Pro', icon: 'premierepro', color: '#b1b1f5' },
  { name: 'Higgsfield AI', img: '/media/logos/higgsfield.png' },
];

// ---- Photography — a horizontal row of categories, each with an inline,
// collapsible drop-down gallery instead of only being reachable by clicking
// into its own page. Every category still links through to its full project
// page too, for larger viewing. ----
const photoCategories = [
  { title: 'Automotive Photography', href: '/projects/automotive-photography', dir: 'automotive', cover: 'automotive/003' },
  { title: 'MyHookah.ca', href: '/projects/my-hookah', dir: 'my-hookah', cover: 'my-hookah/08' },
  { title: 'Turbo Wax', href: '/projects/turbo-wax', dir: 'turbo-wax' },
  { title: 'Vandal Gaming Mouse', href: '/projects/vandal-gaming-mouse', dir: 'vandal-gaming-mouse', cover: 'vandal-gaming-mouse/02' },
  { title: 'Commercial Photography', href: '/projects/commercial-photography', dir: 'commercial-photography', cover: 'commercial-photography/04' },
];
const photographySkills = [
  { name: 'Camera', icon: 'camera' },
  { name: 'Adobe Lightroom', icon: 'lightroom', color: '#7cc4f5' },
  { name: 'Adobe Photoshop', icon: 'photoshop', color: '#7cc4f5' },
];

// ---- Branding — same inline hover-expand category pattern as Industrial
// Design and Photography; full-height single-column galleries with no
// preview cap, so every slide is reachable by scrolling once opened. ----
const brandingCategories = [
  { title: 'Parallel', href: '/projects/parallel', dir: 'parallel-brand', cover: 'covers/parallel' },
  { title: 'Next', href: '/projects/next-real-estate', dir: 'next-branding', cover: 'covers/next-branding' },
  { title: 'Olivera', href: '/projects/olivera', dir: 'olivera', cover: 'covers/olivera' },
];
const brandingSkills = [
  { name: 'Figma', img: '/media/logos/tools/figma.svg' },
  { name: 'Adobe Photoshop', icon: 'photoshop', color: '#7cc4f5' },
  { name: 'Procreate', img: '/media/logos/tools/procreate.png' },
  { name: 'Adobe Illustrator', icon: 'illustrator', color: '#f5b57c' },
  { name: 'Camera', icon: 'camera' },
];

// ---- Graphic Design — closing category; a plain justified gallery, 3 across,
// every poster shown (brand-identity pieces now live under Branding above). ----
const graphicDesignCount = assetsIn('graphic-design-posters').length;
const graphicDesignSkills = [
  { name: 'Sketching', icon: 'pencil' },
  { name: 'Adobe Photoshop', icon: 'photoshop', color: '#7cc4f5' },
];

// ---- Industrial Design — same inline hover-expand category pattern as
// Photography, so each project's process/detail shots are previewable right
// on the homepage instead of only reachable via its own project page. ----
const industrialCategories = [
  { title: 'Eye Care — Capstone', href: '/projects/icare', dir: 'icare-book', cover: 'covers/eye-care-capstone', viewer: 'booklet' },
  { title: 'Balco Furniture Piece', href: '/projects/furniture', dir: 'furniture', cover: 'covers/furniture' },
  { title: 'Inferno Fire Extinguisher', href: '/projects/inferno-fire-extinguisher', dir: 'inferno-fire-extinguisher', cover: 'covers/inferno-fire-extinguisher' },
  { title: 'Product Brand Extension', href: '/projects/product-brand-extension', dir: 'product-brand-extension', cover: 'covers/product-brand-extension' },
  { title: 'Portable Tool Belt', href: '/projects/portable-tool-belt', dir: 'portable-tool-belt', cover: 'covers/portable-tool-belt' },
  { title: 'Walkie Talkie Redesign', href: '/projects/walkie-talkie-redesign', dir: 'walkie-talkie-redesign', cover: 'covers/walkie-talkie-redesign' },
];
const industrialSkills = [
  { name: 'SolidWorks', img: '/media/logos/tools/solidworks.png' },
  { name: 'Procreate', img: '/media/logos/tools/procreate.png' },
  { name: 'Shapr3D', img: '/media/logos/tools/shapr3d.png' },
  { name: 'Adobe Premiere Pro', icon: 'premierepro', color: '#b1b1f5' },
  { name: 'Adobe Photoshop', icon: 'photoshop', color: '#7cc4f5' },
  { name: 'Adobe Illustrator', icon: 'illustrator', color: '#f5b57c' },
  { name: 'Figma', img: '/media/logos/tools/figma.svg' },
  { name: 'KeyShot', img: '/media/logos/tools/keyshot.png' },
  { name: 'Sketching', icon: 'pencil-ruler' },
  { name: 'Model Making', icon: 'box' },
  { name: '3D Printing', icon: 'printer' },
];
---

<Base>
  <SectionNav items={sectionNavItems} />

  <!-- Full-screen video hero -->
  <section class="hero" id="home">
    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/media/portfolio-header-poster.jpg"
    >
      <source src="/media/portfolio-header.mp4" type="video/mp4" />
    </video>
    <div class="hero-scrim"></div>
    <div class="container hero-content">
      <h1 class="hero-title">Julesfolio</h1>
      <p class="hero-line">
        Collection of freelance videography, photography, industrial design
        and graphic design work
      </p>
      <div class="hero-disciplines">
        <span>Videography</span><span>Photography</span><span>Graphic Design</span><span>Industrial Design</span>
      </div>
    </div>
    <div class="hero-cue" aria-hidden="true"><span>Scroll</span></div>
  </section>

  <!-- Multidisciplinary projects — one horizontal row, all 4 visible at once -->
  <section id="work" class="container section">
    <p class="meta feat-label">Multidisciplinary Projects</p>
    <FlagshipRow items={flagships} />
  </section>

  <!-- Full portfolio, one continuous scroll -->
  <DisciplineSection {...videography} skills={videographySkills} videoBrowsePlaysInFeature showBrowseTitles={false} />

  <!-- Short Form Reels — its own category between Videography and Photography.
       Vertical (9:16) clips don't fit the 16:9 discipline-section frame, so
       this gets its own picker layout instead: tall hero + a grid to choose from. -->
  <section class="discipline-block" id="short-form-reels">
    <div class="discipline-head reveal">
      <div class="head-title">
        <h2>Short Form Reels</h2>
        <ul class="skills-row" aria-label="Programs and skills used">
          {shortFormReelsSkills.map((s) => (
            <li class="skill-chip" title={s.name}>
              {s.img ? (
                <img src={s.img} alt={s.name} loading="lazy" />
              ) : (
                <span class="skill-chip-icon" style={s.color ? `color:${s.color}` : undefined} set:html={skillIconSvg(s.icon)} />
              )}
            </li>
          ))}
        </ul>
      </div>
      <span class="count">Vertical social edits · Reels · TikTok · Shorts — {shortFormReels.length} pieces</span>
    </div>
    <div class="container">
      <ShortFormReels items={shortFormReels} />
    </div>
  </section>

  <!-- Photography — horizontal category row, each with an inline expandable
       gallery (see PhotoCategoryRow.astro) instead of the standard feature+browse
       DisciplineSection layout. -->
  <section class="discipline-block" id="photography">
    <div class="discipline-head reveal">
      <div class="head-title">
        <h2>Photography</h2>
        <ul class="skills-row" aria-label="Programs and skills used">
          {photographySkills.map((s) => (
            <li class="skill-chip" title={s.name}>
              {s.img ? (
                <img src={s.img} alt={s.name} loading="lazy" />
              ) : (
                <span class="skill-chip-icon" style={s.color ? `color:${s.color}` : undefined} set:html={skillIconSvg(s.icon)} />
              )}
            </li>
          ))}
        </ul>
      </div>
      <span class="count">Automotive · architectural · commercial — {photoCategories.length} categories</span>
    </div>
    <div class="container">
      <PhotoCategoryRow categories={photoCategories} />
    </div>
  </section>

  <!-- Industrial Design — horizontal category row with an inline expandable
       gallery per project, same pattern as Photography above. -->
  <section class="discipline-block" id="industrial-design">
    <div class="discipline-head reveal">
      <div class="head-title">
        <h2>Industrial Design</h2>
        <ul class="skills-row" aria-label="Programs and skills used">
          {industrialSkills.map((s) => (
            <li class="skill-chip" title={s.name}>
              {s.img ? (
                <img src={s.img} alt={s.name} loading="lazy" />
              ) : (
                <span class="skill-chip-icon" style={s.color ? `color:${s.color}` : undefined} set:html={skillIconSvg(s.icon)} />
              )}
            </li>
          ))}
        </ul>
      </div>
      <span class="count">Products · furniture · capstone — {industrialCategories.length} projects</span>
    </div>
    <div class="container">
      <PhotoCategoryRow categories={industrialCategories} galleryColumns={1} fullGallery />
    </div>
  </section>

  <!-- Branding — same inline category pattern as Photography and Industrial
       Design above; single-column galleries with no preview cap, so opening
       a category is just a continuous vertical scroll through every slide. -->
  <section class="discipline-block" id="branding">
    <div class="discipline-head reveal">
      <div class="head-title">
        <h2>Branding</h2>
        <ul class="skills-row" aria-label="Programs and skills used">
          {brandingSkills.map((s) => (
            <li class="skill-chip" title={s.name}>
              {s.img ? (
                <img src={s.img} alt={s.name} loading="lazy" />
              ) : (
                <span class="skill-chip-icon" style={s.color ? `color:${s.color}` : undefined} set:html={skillIconSvg(s.icon)} />
              )}
            </li>
          ))}
        </ul>
      </div>
      <span class="count">Identity · logo systems · guidelines — {brandingCategories.length} projects</span>
    </div>
    <div class="container">
      <PhotoCategoryRow categories={brandingCategories} galleryColumns={1} fullGallery />
    </div>
  </section>

  <!-- Graphic Design — the closing category; a plain justified gallery
       grid, 3 per row, every poster shown at once (no feature/browse split). -->
  <section class="discipline-block" id="graphic-design">
    <div class="discipline-head reveal">
      <div class="head-title">
        <h2>Graphic Design</h2>
        <ul class="skills-row" aria-label="Programs and skills used">
          {graphicDesignSkills.map((s) => (
            <li class="skill-chip" title={s.name}>
              {s.img ? (
                <img src={s.img} alt={s.name} loading="lazy" />
              ) : (
                <span class="skill-chip-icon" style={s.color ? `color:${s.color}` : undefined} set:html={skillIconSvg(s.icon)} />
              )}
            </li>
          ))}
        </ul>
        <span class="ai-disclosure">No AI generated or aided imagery</span>
      </div>
      <span class="count">Posters · print layout — {graphicDesignCount} pieces</span>
    </div>
    <GalleryGrid dir="graphic-design-posters" columns={3} />
  </section>

  <!-- Skillset strip — reinforces range in words, right before the close -->
  <section class="container">
    <div class="skill-strip reveal">
      <span><b>Direction</b> — concept, storyboard, shot planning</span>
      <span><b>Capture</b> — photography, cinematography, gimbal</span>
      <span><b>Post</b> — Premiere Pro, color, sound design</span>
      <span><b>Brand</b> — identity systems, print, signage</span>
      <span><b>Product</b> — CAD, prototyping, user testing</span>
      <span><b>AI-assisted</b> — generative video/image pipelines</span>
    </div>
  </section>

  <!-- Quiet footer CTA -->
  <section class="container section home-cta reveal">
    <p class="meta">Julian Saliby — design · photo · film</p>
    <p class="cta-line">
      <a href="/about">About</a> · <a href="/contact">Get in touch</a>
    </p>
  </section>
</Base>

<style>
  /* ---- Full-screen video hero ---- */
  .hero {
    position: relative;
    height: 95vh;
    height: 95svh;
    min-height: 520px;
    max-height: 1100px;
    width: 100%;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.85;
  }
  .hero-scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 10, 11, 0.92) 0%, rgba(10, 10, 11, 0.25) 42%, rgba(10, 10, 11, 0.55) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-bottom: clamp(3.5rem, 12vh, 8rem);
  }
  .hero-title {
    font-size: var(--text-hero);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .hero-line {
    margin-top: 1.15rem;
    color: var(--text-secondary);
    max-width: 48ch;
    font-size: var(--text-lg);
    line-height: 1.4;
  }
  .hero-disciplines {
    margin-top: 1.6rem;
    display: flex; gap: 1.4rem; flex-wrap: wrap;
    font-size: var(--text-xs); letter-spacing: 0.1em; text-transform: uppercase; color: var(--text-tertiary);
  }
  .hero-disciplines span { color: var(--text); border-bottom: 1px solid var(--hairline); padding-bottom: 0.15rem; }
  .hero-cue {
    position: absolute;
    z-index: 2;
    bottom: 1.4rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-tertiary);
  }
  .hero-cue span {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    animation: cue 2.4s var(--ease) infinite;
  }
  @keyframes cue { 0%, 100% { opacity: 0.35; } 50% { opacity: 0.9; } }

  .feat-label { margin-bottom: 1.5rem; }

  /* ---- Short Form Reels section — mirrors DisciplineSection's own head styling
     (that CSS is scoped to that component, so it doesn't reach markup written
     directly in this page — duplicated here to match). ---- */
  .discipline-block { margin-block: clamp(3rem, 7vh, 5.5rem); }
  .discipline-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 1rem;
    padding-inline: var(--gutter);
    max-width: var(--max-media); margin: 0 auto 1rem;
    border-bottom: 1px solid var(--hairline);
    padding-bottom: 0.9rem;
  }
  .discipline-head h2 { font-size: clamp(1.3rem, 2.4vw, 1.9rem); font-weight: 600; letter-spacing: -0.01em; }
  .discipline-head .count { font-size: var(--text-xs); color: var(--text-tertiary); letter-spacing: 0.08em; text-transform: uppercase; }
  .head-title { display: flex; align-items: center; gap: 0.9rem; flex-wrap: wrap; }

  .ai-disclosure {
    font-size: var(--text-xs); color: var(--text-tertiary); letter-spacing: 0.02em;
    border: 1px solid var(--hairline); border-radius: 20px; padding: 0.2rem 0.7rem;
    white-space: nowrap;
  }

  .skills-row { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .skill-chip {
    display: grid; place-items: center;
    width: 1.9rem; height: 1.9rem; padding: 0.3rem;
    border-radius: 0.4rem; background: var(--bg-elevated); border: 1px solid var(--hairline);
    overflow: hidden;
  }
  .skill-chip img { width: 100%; height: 100%; object-fit: contain; display: block; border-radius: 0.2rem; }
  .skill-chip-icon { display: grid; place-items: center; width: 100%; height: 100%; color: var(--text-secondary); }
  .skill-chip-icon :global(svg) { width: 100%; height: 100%; object-fit: contain; }

  /* ---- Skillset strip ---- */
  .skill-strip {
    display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .skill-strip span { font-size: var(--text-sm); color: var(--text-secondary); }
  .skill-strip span b { color: var(--text); font-weight: 500; }

  .home-cta { text-align: center; padding-block: clamp(3rem, 8vh, 5rem); }
  .cta-line { margin-top: 0.6rem; }
  .cta-line a { color: var(--text-secondary); }
  .cta-line a:hover { color: var(--accent); }

  @media (prefers-reduced-motion: reduce) {
    .hero-cue span { animation: none; }
  }
</style>
